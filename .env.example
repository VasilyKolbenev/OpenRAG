# ===== OpenRAG Configuration =====

# Database
DATABASE_URL=postgresql+asyncpg://openrag:openrag123@localhost:5432/openrag
REDIS_URL=redis://localhost:6379/0

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Graph Store (Neo4j) — optional, Graph RAG disabled if unavailable
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Authentication
API_KEY_MASTER=              # Master API key (set for production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Application
ENVIRONMENT=development      # development | production
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=104857600    # 100MB
FRONTEND_URL=http://localhost:3000
DOMAIN=localhost
LOG_LEVEL=info

# Embedding
EMBEDDING_PROVIDER=local     # local | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Web Search (for CRAG strategy)
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=tavily   # tavily | serpapi

# RAG Defaults
DEFAULT_TOP_K=10
DEFAULT_TEMPERATURE=0.1
DEFAULT_MODEL=gpt-4o
ADVISOR_MODEL=anthropic/claude-3-haiku-20240307
SUFFICIENCY_THRESHOLD=0.7
RELEVANCE_THRESHOLD=0.7

# Multi-Tenancy (opt-in)
MULTI_TENANCY_ENABLED=false
