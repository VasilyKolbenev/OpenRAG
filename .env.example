# ============================================================
#  OpenRAG configuration template
#  Copy to .env, fill in the secrets, then `docker compose up -d`.
# ============================================================

# -- Required for production boot ---------------------------------
# JWT_SECRET, ENCRYPTION_KEY, OPENRAG_ADMIN_PASSWORD must be set when
# ENVIRONMENT=production. The backend refuses to start otherwise.

# At least one model provider key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a local LLM endpoint (Ollama, vLLM, etc.)
OLLAMA_BASE_URL=http://localhost:11434

# -- Authentication (production) ---------------------------------
# 32+ random characters for JWT signing
JWT_SECRET=change-me-to-a-strong-32-plus-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 32+ random characters for field-level encryption (production gate)
ENCRYPTION_KEY=

# 12+ characters. Operators exchange this for a JWT via POST /api/auth/login.
OPENRAG_ADMIN_PASSWORD=

# -- Database & Infra (development defaults shown) ---------------
DATABASE_URL=postgresql+asyncpg://openrag:openrag123@postgres:5432/openrag
REDIS_URL=redis://:redis123@redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# Internal docker-compose passwords (override in prod via secret manager)
POSTGRES_USER=openrag
POSTGRES_PASSWORD=openrag123
POSTGRES_DB=openrag
REDIS_PASSWORD=redis123

# -- Application ------------------------------------------------
ENVIRONMENT=development        # development | production
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
DOMAIN=localhost               # public hostname for TLS in production
ACME_EMAIL=admin@example.com   # Let's Encrypt account email (production)

# -- Embedding --------------------------------------------------
EMBEDDING_PROVIDER=local       # local | openai
EMBEDDING_MODEL=BAAI/bge-m3    # Local default (1024 dims, ~2GB)
EMBEDDING_DIMENSIONS=1024

# -- LLM Defaults -----------------------------------------------
DEFAULT_MODEL=openai/gpt-5.4
ADVISOR_MODEL=openai/gpt-5.4-mini
DEFAULT_TOP_K=10
DEFAULT_TEMPERATURE=0.1

# -- Optimizers (cross-engine) ---------------------------------
TURBOQUANT_ENABLED=true
TURBOQUANT_DEFAULT_BITS=4
QUANTIZATION_ENABLED=false
QUANTIZATION_OVERSAMPLING=2.0

# -- Optional features -----------------------------------------
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=tavily     # tavily | serpapi
MULTI_TENANCY_ENABLED=false

# -- Monitoring (production) -----------------------------------
GRAFANA_PASSWORD=admin
HTTP_PORT=80
HTTPS_PORT=443
